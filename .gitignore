node_modules
application/frontend/dist
application/frontend/wailsjs
build
venv
*.pem
*.lic
breachline

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lock files (optional - some teams commit this)
.terraform.lock.hcl

*.zip

# Centralized config/secrets machinery. config.yml + secrets.vault.yml are
# COMMITTED; the rendered outputs + vault password below are not.
# (config.yml is non-secret; secrets.vault.yml is ansible-vault encrypted.)
secrets.env
.vault-password-file
__pycache__/
